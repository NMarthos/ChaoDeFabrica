PORT=3001
JWT_SECRET=super_secret_jwt_token_key_12345

# Caminhos persistentes (recomendado para Hostinger fora da pasta sincronizada pelo git)
# Exemplo: DATABASE_PATH=/home/u123456/data/erp.db
DATABASE_PATH=./database/erp.db

# Exemplo: UPLOADS_PATH=/home/u123456/uploads
UPLOADS_PATH=./uploads

# Caminho opcional do frontend compilado caso deseje customizar
# FRONTEND_DIST_PATH=../frontend/dist

# Google Drive Integration Config
GOOGLE_DRIVE_CLIENT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_DRIVE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
GOOGLE_DRIVE_FOLDER_ID=your-google-drive-folder-id

